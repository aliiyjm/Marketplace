# Copy this file as .env (same folder) and fill in your values.
# .env is in .gitignore: NEVER commit it (it has passwords and the API key).
# If a password contains # or spaces, put it in quotes: MYSQL_PASSWORD="my#pass"

# ---------- where each kind of data lives ----------
# memory = demo data generated in the app (nothing is saved)
FINANCE_BACKEND=mysql          # orders, payments, invoices      -> MySQL finance_db
OPERATIONS_BACKEND=postgres    # categories, sellers, reviews... -> PostgreSQL
DATA_BACKEND=aws               # users, carts, favorites          -> DynamoDB (Lambda)
PRODUCTS_BACKEND=aws           # 17,000 products                  -> DynamoDB (Lambda)

# ---------- MySQL (finance_db) ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=finance_db

# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=operations_db

# ---------- API Gateway + Lambda ----------
API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
MARKETPLACE_API_KEY=

# ---------- Flask ----------
# Any long random text; keeps sessions valid after a restart.
SECRET_KEY=
